# --- Site ---
# Public base URL of this app (no trailing slash). Used for canonical URLs,
# Open Graph/Twitter tags, and sitemap.xml. Falls back to BETTER_AUTH_URL if unset.
VITE_SITE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/devlinks

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-char-random-string
# Base URL of THIS app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://devlinks.app)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- OAuth Providers ---
# Set GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET to enable GitHub sign-in.
# Then set VITE_AUTH_GITHUB_ENABLED=true to surface the button in the UI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_AUTH_GITHUB_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_AUTH_GOOGLE_ENABLED=false

# --- Analytics ---
# Salt for hashing visitor IPs on profile view/click analytics (rotates
# weekly, see src/lib/analytics-parse.server.ts). REQUIRED — hashIP() throws
# if this isn't set (view/click tracking then silently no-ops instead of
# crashing, see the try/catch around it). Generate with: openssl rand -base64 32
ANALYTICS_SALT=

# --- Product analytics (PostHog) ---
# Project API key from your PostHog project (Project settings > API keys) —
# it's a public/client-side key, safe to expose in the browser bundle. Without
# it, posthog.init() never runs and the cookie consent banner never shows
# (see src/integrations/posthog/provider.tsx) — nothing to consent to.
VITE_POSTHOG_KEY=
# Ingestion host for your PostHog project's region (US Cloud: default below,
# leave unset; EU Cloud: https://eu.i.posthog.com; self-hosted: your own URL).
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Email (Resend) ---
# Without RESEND_API_KEY, emails are logged to the console (dev only).
RESEND_API_KEY=
EMAIL_FROM=no-reply@devlinks.app
# Inbox that receives /contact form submissions
CONTACT_EMAIL=support@devlinks.app

# --- Cloudflare R2 (avatar storage) ---
# Create a bucket + API token with Object Read & Write at dash.cloudflare.com/?to=/:account/r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=devlinks-avatars
# Public base URL for the bucket (r2.dev subdomain or a custom domain), no trailing slash
R2_PUBLIC_URL=

# --- Integrations (GitHub) ---
# Optional but strongly recommended: a classic PAT with no scopes (public
# read access only) at github.com/settings/tokens. Without it, the GitHub
# integration hits the API unauthenticated — 60 requests/hour shared across
# EVERY DevLinks user — and starts failing under real traffic. With a token,
# the limit is 5,000 requests/hour.
GITHUB_TOKEN=

# --- Integrations (YouTube) ---
# API key from a Google Cloud project with the "YouTube Data API v3" enabled
# (console.cloud.google.com/apis/credentials) — restrict it to that API.
# Free quota (10,000 units/day) covers thousands of profile syncs, since
# each sync costs 2 units (1 channels.list + 1 playlistItems.list).
YOUTUBE_API_KEY=

# --- Integrations (Product Hunt) ---
# OAuth app credentials from your Product Hunt API dashboard
# (producthunt.com/v2/oauth/applications) — Confidential client. Product
# Hunt has no API to read someone else's launches (viewer.user.madePosts
# only works authenticated as that person), so each DevLinks user connects
# their own account via a real "Connect with Product Hunt" OAuth flow
# (src/routes/api/integrations/producthunt/). Register the redirect URI as
# {BETTER_AUTH_URL}/api/integrations/producthunt/callback.
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# --- Integrations (Dribbble) ---
# OAuth app credentials from dribbble.com/account/applications — same
# reasoning as Product Hunt: no public read API for a third party's
# shots, only /user/shots authenticated as that user, so this connects
# via OAuth too (src/routes/api/integrations/dribbble/). Register the
# redirect URI as {BETTER_AUTH_URL}/api/integrations/dribbble/callback.
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# --- Integrations (Pinterest) ---
# OAuth app credentials from developers.pinterest.com — same reasoning
# as Product Hunt/Dribbble: GET /pins only ever returns the token
# user_account's own pins, so this connects via OAuth too
# (src/routes/api/integrations/pinterest/). Register the redirect URI
# as {BETTER_AUTH_URL}/api/integrations/pinterest/callback. Note: the
# app needs Pinterest's "Standard access" review (a recorded OAuth flow
# walkthrough) before pins are visible beyond your own sandbox — Trial
# access alone won't show real content on public profiles.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- Integrations cron ---
# Authorizes POST/GET on /api/public/hooks/integrations-refresh (refreshes
# stale integration data once a day — Vercel Hobby cron limit; bump to every
# 6h if you're on Pro). Generate with: openssl rand -base64 32
# Set the same value as a Vercel env var named CRON_SECRET — Vercel then
# sends it automatically as "Authorization: Bearer $CRON_SECRET" when it
# invokes the cron job defined in vercel.json.
CRON_SECRET=

# --- Dodo Payments (billing) ---
# API key from the Dodo dashboard (Developer > API Keys). Use a test_mode key
# while DODO_PAYMENTS_ENVIRONMENT=test_mode.
DODO_PAYMENTS_API_KEY=
# Signing key for verifying webhook requests (Developer > Webhooks > your endpoint).
# Webhook URL to register in Dodo: {BETTER_AUTH_URL}/api/auth/dodopayments/webhooks
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode (sandbox) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product ID for the Pro plan ($5/mo). Sandbox and live products have
# different IDs in the Dodo dashboard — update this when switching to live_mode.
DODO_PRO_PRODUCT_ID=pdt_REPLACE_ME
