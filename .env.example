# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/devlinks

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-char-random-string
# Base URL of THIS app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://devlinks.app)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- Email (Resend) ---
# Without RESEND_API_KEY, emails are logged to the console (dev only).
RESEND_API_KEY=
EMAIL_FROM=no-reply@devlinks.app
